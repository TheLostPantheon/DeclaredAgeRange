<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
        <!--
          Local runs are ad-hoc signed. macOS refuses to launch an ad-hoc signed app that carries a restricted
          entitlement, so the entitlements file is only applied when you build with a real identity and profile:
            dotnet build -t:Run -p:CodesignKey="Apple Development" -p:CodesignProvision="<profile name>"
        -->
        <CodesignKey>-</CodesignKey>
        <CodesignEntitlements Condition="'$(CodesignKey)' != '-'">DeclaredAgeRange.entitlements</CodesignEntitlements>
    </PropertyGroup>

    <ItemGroup>
      <!-- In your own app use: <PackageReference Include="DeclaredAgeRange" Version="1.0.0" /> -->
      <ProjectReference Include="..\..\src\DeclaredAgeRange\DeclaredAgeRange.csproj" />
    </ItemGroup>
</Project>
